{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "18277429315864593840"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "spectrum-adventure",
      "metadata": {
        "description": "Short application name used for resource naming."
      }
    },
    "containerAppName": {
      "type": "string",
      "defaultValue": "spectrum-adventure-web",
      "metadata": {
        "description": "Container App name."
      }
    },
    "registryName": {
      "type": "string",
      "defaultValue": "spectrumadventure",
      "metadata": {
        "description": "Container registry name suffix."
      }
    },
    "postgresAdminUsername": {
      "type": "string",
      "defaultValue": "pgadmin",
      "metadata": {
        "description": "PostgreSQL admin username."
      }
    },
    "postgresAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "PostgreSQL admin password."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Deployment container image reference, e.g. myregistry.azurecr.io/spectrum-adventure:latest. This must be set explicitly for a real deployment; the sample image is intentionally not the default."
      }
    },
    "deployAiFoundry": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Deploy an Azure AI Foundry account with the chat and image model deployments. Set to false to reuse an existing endpoint via azureAiEndpoint."
      }
    },
    "aiFoundryLocation": {
      "type": "string",
      "defaultValue": "[parameters('location')]",
      "metadata": {
        "description": "Region for the Azure AI Foundry account. Model availability is region specific, so it can differ from the app region."
      }
    },
    "deployAiFoundryImageModel": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Set to false when the image model is not available in aiFoundryLocation."
      }
    },
    "azureAiEndpoint": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Azure AI Foundry / Azure OpenAI endpoint for the app. Leave empty to use the endpoint of the AI Foundry account deployed by this template."
      }
    },
    "azureAiChatDeployment": {
      "type": "string",
      "defaultValue": "gpt-4.1-mini",
      "metadata": {
        "description": "Chat deployment name for Azure OpenAI."
      }
    },
    "azureAiChatModelName": {
      "type": "string",
      "defaultValue": "gpt-4.1-mini",
      "metadata": {
        "description": "Chat model name in the Azure OpenAI catalogue."
      }
    },
    "azureAiChatModelVersion": {
      "type": "string",
      "defaultValue": "2025-04-14",
      "metadata": {
        "description": "Chat model version."
      }
    },
    "azureAiImageDeployment": {
      "type": "string",
      "defaultValue": "gpt-image-1-mini",
      "metadata": {
        "description": "Image deployment name for Azure OpenAI."
      }
    },
    "azureAiImageModelName": {
      "type": "string",
      "defaultValue": "gpt-image-1-mini",
      "metadata": {
        "description": "Image model name in the Azure OpenAI catalogue."
      }
    },
    "azureAiImageModelVersion": {
      "type": "string",
      "defaultValue": "2025-10-06",
      "metadata": {
        "description": "Image model version."
      }
    },
    "appInsightsConnectionString": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application Insights connection string used by the app."
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "normalizedAppName": "[toLower(replace(parameters('appName'), '_', '-'))]",
    "logAnalyticsWorkspaceName": "[take(format('law-{0}-{1}', variables('normalizedAppName'), variables('uniqueSuffix')), 63)]",
    "appInsightsName": "[take(format('appi-{0}-{1}', variables('normalizedAppName'), variables('uniqueSuffix')), 255)]",
    "storageAccountName": "[take(replace(toLower(format('st{0}{1}', variables('normalizedAppName'), variables('uniqueSuffix'))), '-', ''), 24)]",
    "acrName": "[take(replace(toLower(format('{0}{1}', parameters('registryName'), variables('uniqueSuffix'))), '-', ''), 50)]",
    "postgresServerName": "[take(format('psql-{0}-{1}', variables('normalizedAppName'), variables('uniqueSuffix')), 63)]",
    "databaseName": "adventure",
    "visualAssetsContainerName": "visual-assets",
    "identityName": "[format('id-{0}-{1}', variables('normalizedAppName'), variables('uniqueSuffix'))]",
    "aiFoundryAccountName": "[take(format('aif-{0}-{1}', variables('normalizedAppName'), variables('uniqueSuffix')), 63)]",
    "aiFoundryProjectName": "[take(format('proj-{0}', variables('normalizedAppName')), 32)]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]",
        "Flow_Type": "Bluefield",
        "Request_Source": "rest",
        "RetentionInDays": 90
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "accessTier": "Hot",
        "allowBlobPublicAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "publicNetworkAccess": "Enabled",
        "allowSharedKeyAccess": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageAccountName'), 'default')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageAccountName'), 'default', variables('visualAssetsContainerName'))]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": true
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2023-06-01-preview",
      "name": "[variables('postgresServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B2s",
        "tier": "Burstable"
      },
      "properties": {
        "version": "16",
        "administratorLogin": "[parameters('postgresAdminUsername')]",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Disabled"
        },
        "backup": {
          "backupRetentionDays": 7
        },
        "network": {
          "publicNetworkAccess": "Enabled",
          "delegatedSubnetResourceId": null,
          "privateDnsZoneArmResourceId": null
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "availabilityZone": "1",
        "createMode": "Default"
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2023-06-01-preview",
      "name": "[format('{0}/{1}', variables('postgresServerName'), variables('databaseName'))]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', variables('postgresServerName'))]"
      ]
    },
