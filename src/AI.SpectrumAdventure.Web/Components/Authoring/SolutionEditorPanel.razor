<section aria-labelledby="solution-editor-heading">
    <h2 id="solution-editor-heading">Puzzle solutions</h2>
    <EditForm Model="solution" OnValidSubmit="SaveAsync">
        <InputText @bind-Value="puzzleId" placeholder="Puzzle id" />
        <InputText @bind-Value="solution.Id" placeholder="Solution id" />
        <InputText @bind-Value="solution.Type" placeholder="Condition type" />
        <InputText @bind-Value="solution.ReferenceId" placeholder="Reference id" />
        <button type="submit">Add or update solution</button>
    </EditForm>
</section>

@code {
    [Parameter, EditorRequired] public string DefinitionJson { get; set; } = "{}";
    [Parameter] public EventCallback<string> OnDefinitionChanged { get; set; }
    private string puzzleId = "";
    private SolutionModel solution = new();
    private Task SaveAsync() => OnDefinitionChanged.InvokeAsync(DraftDefinitionEditor.UpsertPuzzleSolution(DefinitionJson, puzzleId,
        new AuthoringPuzzleSolution(solution.Id, [new AuthoringPuzzleCondition(solution.Type, solution.ReferenceId)])));
    private sealed class SolutionModel { public string Id { get; set; } = ""; public string Type { get; set; } = "ItemPossessed"; public string ReferenceId { get; set; } = ""; }
}
