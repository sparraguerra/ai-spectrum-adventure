<section aria-labelledby="item-editor-heading">
    <h2 id="item-editor-heading">Items</h2>
    <EditForm Model="item" OnValidSubmit="SaveAsync">
        <InputText @bind-Value="item.Id" placeholder="Item id" />
        <InputText @bind-Value="item.Name" placeholder="Name" />
        <InputTextArea @bind-Value="item.Description" placeholder="Description" />
        <button type="submit">Add or update item</button>
    </EditForm>
</section>

@code {
    [Parameter, EditorRequired] public string DefinitionJson { get; set; } = "{}";
    [Parameter] public EventCallback<string> OnDefinitionChanged { get; set; }
    private ItemModel item = new();

    private Task SaveAsync() => OnDefinitionChanged.InvokeAsync(DraftDefinitionEditor.UpsertItem(DefinitionJson,
        new AuthoringItem(item.Id, item.Name, item.Description)));

    private sealed class ItemModel
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}