<section aria-labelledby="start-location-editor-heading">
    <h2 id="start-location-editor-heading">Starting location</h2>
    <InputText @bind-Value="locationId" placeholder="Starting location id" />
    <button type="button" @onclick="SaveAsync">Set starting location</button>
</section>

@code {
    [Parameter, EditorRequired] public string DefinitionJson { get; set; } = "{}";
    [Parameter] public EventCallback<string> OnDefinitionChanged { get; set; }
    private string locationId = string.Empty;

    private Task SaveAsync() => OnDefinitionChanged.InvokeAsync(DraftDefinitionEditor.SetStartingLocation(DefinitionJson, locationId));
}