<section aria-labelledby="chain-editor-heading">
    <h2 id="chain-editor-heading">Puzzle chains and outcomes</h2>
    <EditForm Model="chain" OnValidSubmit="SaveAsync">
        <InputText @bind-Value="chain.PuzzleId" placeholder="Puzzle id" />
        <InputText @bind-Value="chain.NextPuzzleId" placeholder="Next puzzle id" />
        <InputText @bind-Value="chain.OutcomeId" placeholder="Outcome id" />
        <button type="submit">Link puzzle chain</button>
    </EditForm>
</section>

@code {
    [Parameter, EditorRequired] public string DefinitionJson { get; set; } = "{}";
    [Parameter] public EventCallback<string> OnDefinitionChanged { get; set; }
    private ChainModel chain = new();
    private Task SaveAsync() => OnDefinitionChanged.InvokeAsync(DraftDefinitionEditor.AddPuzzleChainLink(DefinitionJson, chain.PuzzleId, chain.NextPuzzleId));
    private sealed class ChainModel { public string PuzzleId { get; set; } = ""; public string NextPuzzleId { get; set; } = ""; public string OutcomeId { get; set; } = ""; }
}
