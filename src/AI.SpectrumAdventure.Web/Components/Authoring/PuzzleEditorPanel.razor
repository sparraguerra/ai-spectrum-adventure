<section aria-labelledby="puzzle-editor-heading">
    <h2 id="puzzle-editor-heading">Reusable puzzles</h2>
    <EditForm Model="puzzle" OnValidSubmit="SaveAsync">
        <InputText @bind-Value="puzzle.Id" placeholder="Puzzle id" />
        <InputText @bind-Value="puzzle.ChainLinks" placeholder="Chain links, comma separated" />
        <button type="submit">Add or update puzzle</button>
    </EditForm>
</section>

@code {
    [Parameter, EditorRequired] public string DefinitionJson { get; set; } = "{}";
    [Parameter] public EventCallback<string> OnDefinitionChanged { get; set; }
    private PuzzleModel puzzle = new();
    private Task SaveAsync() => OnDefinitionChanged.InvokeAsync(DraftDefinitionEditor.UpsertPuzzle(DefinitionJson,
        new AuthoringPuzzle(puzzle.Id, ChainLinks: Values(puzzle.ChainLinks))));
    private static IReadOnlyList<string> Values(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private sealed class PuzzleModel { public string Id { get; set; } = ""; public string ChainLinks { get; set; } = ""; }
}
