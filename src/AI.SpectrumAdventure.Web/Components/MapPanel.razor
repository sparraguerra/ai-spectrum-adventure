@using AI.SpectrumAdventure.Application.Worlds
@using AI.SpectrumAdventure.Domain.Games
@using AI.SpectrumAdventure.Domain.Worlds

<section aria-labelledby="discovered-map-heading">
    <h2 id="discovered-map-heading" class="h5 mb-3">Discovered map</h2>

    @if (Map.Locations.Count == 0)
    {
        <p class="mb-0 text-muted">No map details confirmed.</p>
    }
    else
    {
        <h3 class="h6 text-muted">Locations</h3>
        <ul class="list-group list-group-flush mb-3">
            @foreach (var location in Map.Locations)
            {
                <li class="list-group-item px-0 d-flex justify-content-between gap-2">
                    <span>@location.Name</span>
                    <span class="badge text-bg-secondary align-self-center">@location.State</span>
                </li>
            }
        </ul>

        @if (Map.Connections.Count > 0)
        {
            <h3 class="h6 text-muted">Paths</h3>
            <ul class="list-group list-group-flush mb-0">
                @foreach (var connection in Map.Connections)
                {
                    <li class="list-group-item px-0 d-flex justify-content-between gap-2">
                        <span>@connection.Direction: @connection.SourceLocationName → @connection.DestinationLocationName</span>
                        <span class="badge text-bg-@(connection.Availability == ConnectionAvailability.Available ? "success" : "secondary") align-self-center">@connection.Availability</span>
                    </li>
                }
            </ul>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public Game Game { get; set; } = null!;
    [Parameter, EditorRequired] public World World { get; set; } = null!;

    private DiscoveredMap Map => GetDiscoveredMapQuery.Execute(Game, World);
}