    <ProjectReference Include="..\AI.SpectrumAdventure.Infrastructure\AI.SpectrumAdventure.Infrastructure.csproj" />
    <ProjectReference Include="..\AI.SpectrumAdventure.Agents\AI.SpectrumAdventure.Agents.csproj" />
